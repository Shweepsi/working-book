{
  "manifest_version": 3,
  "name": "Working Book — import Operator Mashup",
  "version": "2.1.1",
  "description": "Envoie le rapport PMS230 de l'Operator Mashup vers Working Book, sans copier-coller.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://*.inforcloudsuite.com/*", "https://working-book-api.loic-cancelotti.workers.dev/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.inforcloudsuite.com/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["mashup.js", "content.js"]
    }
  ],
  "action": {
    "default_title": "Working Book — lancer la recherche et importer le rapport",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
