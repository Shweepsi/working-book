{
  "manifest_version": 3,
  "name": "Working Book — import Operator Mashup",
  "version": "1.0.0",
  "description": "Envoie le rapport PMS230 de l'Operator Mashup vers Working Book, sans copier-coller.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.inforcloudsuite.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.inforcloudsuite.com/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "Envoyer le rapport vers Working Book"
  },
  "options_page": "options.html"
}
